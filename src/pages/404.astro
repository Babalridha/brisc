---
import Layout from '../components/Layout.astro';
---

<Layout title="Page Not Found | BRISC" robots="noindex">
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    <p class="font-bold tracking-widest">404</p>
    <h1 class="mt-4 text-4xl font-extrabold">Page not found</h1>
    <p class="mt-4">The page you requested does not exist.</p>
    <a class="mt-8 inline-block rounded-full bg-[#134503] px-6 py-3 text-white" href="/">Return home</a>
  </section>
</Layout>
